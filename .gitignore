# Local configuration
#   Public files: .env, .env.<environment>
#   Secret files: .env.local, .env.<environment>.local
#   Load order:
#     (1) .env
#     (2) .env.<environment>
#     (3) .env.local
#     (4) .env.<environment>.local
#   Note: Later files override earlier ones.
*.local

# IDEs
.cursor/
.idea/

# macOS
.DS_Store
