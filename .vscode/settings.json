{
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    "source.action.noDuplicateClasses.biome": "explicit",
    "source.action.useSortedAttributes.biome": "explicit",
    "source.action.useSortedPackageJson.biome": "explicit",
    "source.action.useSortedProperties.biome": "explicit"
  },
  "biome.configurationPath": "apps/client/biome.json",
  "biome.lsp.bin": "apps/client/node_modules/.bin/biome",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "python.defaultInterpreterPath": "apps/server/.venv/bin/python",
  "python.languageServer": "None",
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "apps/server",
  "css.customData": [".vscode/tailwind.json"],
  "yaml.schemas": {
    "apps/server/settings.schema.yaml": [
      "apps/server/settings.yaml",
      "apps/server/settings.example.yaml"
    ]
  },
  "files.readonlyInclude": {
    "**/pnpm-lock.yaml": true,
    "**/__generated__/**": true,
    "**/routeTree.gen.ts": true,
    "**/uv.lock": true
  },
  "files.watcherExclude": {
    "**/.pnpm-store/**": true,
    "**/.venv/**": true,
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/.pnpm-store/**": true,
    "**/.venv/**": true,
    "**/pnpm-lock.yaml": true,
    "**/routeTree.gen.ts": true,
    "**/uv.lock": true
  }
}
