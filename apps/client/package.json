{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --host --port 3000",
    "fmt": "pnpm fmt:b && pnpm fmt:p",
    "fmt:b": "biome check --write",
    "fmt:p": "prettier \"**/*.{md,yaml,yml}\" --write",
    "gen": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale && mkdir -p __generated__ && uv run --directory ../server xavier --settings settings.example.yaml openapi > __generated__/openapi.json && openapi-typescript __generated__/openapi.json --output __generated__/schema.ts",
    "lint": "pnpm lint:b && pnpm lint:p",
    "lint:b": "biome check",
    "lint:p": "prettier \"**/*.{md,yaml,yml}\" --check",
    "preview": "vite preview --host --port 3000",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm gen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hyperdx/browser": "^0.26.0",
    "@novnc/novnc": "^1.7.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "openapi-fetch": "^0.17.0",
    "papaparse": "^5.7.1",
    "plotly.js-cartesian-dist-min": "^4.3.0",
    "plotly.js-strict-dist-min": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@inlang/paraglide-js": "^3.2.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@types/node": "^26.6.6",
    "@types/novnc__novnc": "^1.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "nitro": "3.0.261103-rc",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "22.22.2"
  }
}
